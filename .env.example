# =====================================================================
#  Détente & Loisirs / Henri & Philippe — variables d'environnement
#
#  EN PRODUCTION (LWS / cPanel) : ces valeurs se saisissent dans
#  « Setup Node.js App » → section « Environment variables ».
#  Le fichier .env sert aux scripts en ligne de commande et au poste local ;
#  une variable déjà définie dans l'environnement n'est jamais écrasée.
#
#  NE JAMAIS VERSIONNER LE FICHIER .env RÉEL (mots de passe en clair).
# =====================================================================

# --- Serveur ---------------------------------------------------------
PORT=3456
# Adresse publique du site : indispensable pour construire les liens de
# confirmation et de désabonnement envoyés par e-mail.
PUBLIC_SITE_URL=https://henri-philippe.com

# --- Base de données MySQL (cPanel) ----------------------------------
# Laisser DB_HOST vide fait tourner le site sur les fichiers JSON de data/.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=c2828676c_henri&philippe
DB_USER=c2828676c_henri
DB_PASSWORD=

# --- Authentification du studio --------------------------------------
# ADMIN_SECRET est l'ANCIENNE clé partagée. Elle n'ouvre le studio que
# TANT QU'AUCUN COMPTE UTILISATEUR N'EXISTE (mode dégradé, journalisé).
# Dès la création du premier compte, elle cesse de fonctionner et peut
# être retirée d'ici.
#   node scripts/creer-utilisateur.js --username henri --role proprietaire
ADMIN_SECRET=

# Cookie de session : auto | true | false
#   auto (défaut) → attribut Secure partout, sauf en http sur localhost
#                   (le navigateur refuserait alors d'enregistrer le cookie)
#   true          → attribut Secure toujours posé (recommandé en production)
COOKIE_SECURE=auto

# Nombre maximum de tentatives de connexion par adresse IP, par tranche de
# 15 minutes (en plus du verrouillage progressif par compte).
LOGIN_RATE_MAX=20

# --- Envoi d'e-mails (SMTP cPanel) -----------------------------------
# Sans ces variables, le site fonctionne normalement : les messages sont
# simplement mis en file d'attente et signalés dans le studio.
SMTP_HOST=mail.henri-philippe.com
# 465 = SSL implicite (recommandé chez LWS) · 587 = STARTTLS
SMTP_PORT=465
# auto (défaut, déduit du port) | true | false
SMTP_SECURE=auto
SMTP_USER=contact@henri-philippe.com
SMTP_PASSWORD=
MAIL_FROM=Henri & Philippe <contact@henri-philippe.com>
MAIL_REPLY_TO=contact@henri-philippe.com
# Destinataire des notifications internes (nouvelles demandes clients)
MAIL_TO=contact@henri-philippe.com

# --- Newsletter ------------------------------------------------------
# Inscriptions autorisées par adresse IP et par heure.
NEWSLETTER_RATE_MAX=5
# Envoi des campagnes par lots, pour ne pas saturer le SMTP mutualisé.
NEWSLETTER_BATCH_SIZE=25
NEWSLETTER_BATCH_DELAY_MS=1000
# Secret servant à dériver les liens de désabonnement. S'il change, les liens
# déjà envoyés cessent de fonctionner (les abonnés, eux, restent intacts).
# Laissé vide : ADMIN_SECRET est utilisé, sinon un secret est généré une fois
# et conservé dans data/app-secret.json.
NEWSLETTER_TOKEN_SECRET=

# --- Passerelle Facebook / Meta Graph API ----------------------------
META_GRAPH_VERSION=v25.0
# Identifiant de l'application Meta. Sert au serveur et au script
# scripts/jeton-facebook.js, qui convertit un jeton court en jeton de Page
# permanent. Ce n'est PAS un secret : il est visible dans l'URL du tableau
# de bord Meta.
META_APP_ID=1394121669475304
META_PAGE_ID=100075922063365
# Jeton de PAGE, obtenu via `node scripts/jeton-facebook.js <jeton-court>`.
# Un jeton utilisateur copié directement depuis l'explorateur expire en une
# heure et arrête la passerelle sans message d'erreur.
META_PAGE_ACCESS_TOKEN=
# Chaîne de votre choix, à recopier à l'identique dans la configuration du
# webhook côté Meta.
META_VERIFY_TOKEN=
META_APP_SECRET=
# Resynchronisation de secours toutes les 15 minutes (minimum : 60000)
META_SYNC_INTERVAL_MS=900000
