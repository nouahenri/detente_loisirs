{
  "expo": {
    "name": "Détente & Loisirs",
    "owner": "nouahenris-team",
    "slug": "henriphlippe",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone.png",
    "scheme": "detenteloisirs",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f3f4f9",
    "ios": {
      "bundleIdentifier": "com.henriphilippe.detenteloisirs",
      "buildNumber": "3",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tel",
          "mailto"
        ],
        "CFBundleLocalizations": [
          "fr",
          "en",
          "es"
        ]
      }
    },
    "android": {
      "package": "com.henriphilippe.detenteloisirs",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icone-android-premier-plan.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/ecran-demarrage-android",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo-splash.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#ffffff"
          },
          "android": {
            "imageWidth": 164
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "en",
              "es"
            ],
            "android": [
              "fr",
              "en",
              "es"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icone-notification.png",
          "color": "#151837",
          "defaultChannel": "default"
        }
      ],
      "expo-background-task",
      "./plugins/jdk-gradle-21",
      "./plugins/architecture-android",
      "./plugins/bundle-debug-android",
      "./plugins/liens-android"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c68bb842-ffaf-46fa-8d55-d1e6b697bff4"
      }
    }
  }
}
